# Copy this file to .env and fill in the blanks. Never commit .env.

# LiveKit Cloud project. Find these at https://cloud.livekit.io under
# your project's Settings > API keys. The URL must be the same project
# the keys belong to.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which AI writes the agent's replies: gemini or claude.
LLM_PROVIDER=gemini

# Gemini. A free key comes from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini-3.5-flash-lite is on Google's free tier and starts replying fastest.
# gemini-3.8-flash is smarter but slower to start speaking.
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude. Only needed when LLM_PROVIDER=claude. Key from https://platform.claude.com
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is faster and cheaper, which suits phone calls.
AGENT_CLAUDE_MODEL=claude-opus-5-5
# How much Claude reasons before it speaks: low, medium or high.
AGENT_CLAUDE_EFFORT=low

# Comma-separated origins allowed to call the token server from a browser.
ALLOWED_ORIGINS=*
# Port the token server listens on.
PORT=8000
